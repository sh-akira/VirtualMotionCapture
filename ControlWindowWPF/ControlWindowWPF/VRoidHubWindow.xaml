<Window x:Class="VirtualMotionCaptureControlPanel.VRoidHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualMotionCaptureControlPanel"
        mc:Ignorable="d"
        Title="{DynamicResource VRoidHubWindowTitle}" MinHeight="600" MinWidth="1124" Height="600" Width="1124" Loaded="Window_Loaded" Closing="Window_Closing" Activated="Window_Activated" Icon="Resources/VirtualMotionCapture_dark.ico">
    <Grid ClipToBounds="True">
        <Grid Name="LoginGrid" Background="White" Visibility="Visible">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource VRoidHubWindow_LoginDescription}" TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="20" Width="500"/>
                <Button Content="{DynamicResource VRoidHubWindow_Login}" HorizontalAlignment="Center" Padding="50,0" Height="60" Name="DoLoginButton" Click="DoLoginButton_Click" FontSize="18" Margin="30"/>
            </StackPanel>
        </Grid>
        <Grid Name="ErrorGrid" Background="White" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
                <TextBlock Text="{DynamicResource VRoidHubWindow_ErrorDescription}" HorizontalAlignment="Center" Margin="20"/>
                <TextBlock Text="" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="20,0,20,20" Name="ErrorTextBlock"/>
            </StackPanel>
        </Grid>
        <Grid Name="CodeGrid" Background="White" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
                <TextBlock Text="{DynamicResource VRoidHubWindow_CodeDescription}" HorizontalAlignment="Center" Margin="20" FontSize="20"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Name="RegisterCodeTextBox" FontSize="17"/>
                    <Button Content="{DynamicResource VRoidHubWindow_Paste}" Name="PasteCodeButton" Click="PasteCodeButton_Click" Padding="20,0" FontSize="17"/>
                    <Button Content="{DynamicResource VRoidHubWindow_Register}" Name="RegisterCodeButton" Click="RegisterCodeButton_Click" Padding="20,0" FontSize="17"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Name="ModelListGrid" Background="White" Visibility="Collapsed">
            <Image Source="{Binding full_body_image_original}" HorizontalAlignment="Left" Margin="{Binding full_body_image_margin}"/>
            <Grid VerticalAlignment="Top" Height="25">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.6"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>
            </Grid>
            <Grid HorizontalAlignment="Left" Width="375">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.95"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>
            </Grid>
            <Grid VerticalAlignment="Bottom" Height="113">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.2"/>
                        <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>
            </Grid>
            <DockPanel>
                <GroupBox Header="{DynamicResource VRoidHubWindow_ModelList}" DockPanel.Dock="Left" FontSize="14" BorderThickness="0" BorderBrush="Transparent">
                    <DockPanel>
                        <Button Content="{DynamicResource VRoidHubWindow_FindModelOnVRoidHub}" Padding="30,10,30,10" Margin="0,5,0,0" Name="VRoidHubFindModelButton" Click="VRoidHubFindModelButton_Click" DockPanel.Dock="Bottom" HorizontalAlignment="Left"/>
                        <ListBox Name="ModelListBox" Width="350" Background="Transparent" SelectionChanged="ModelListBox_SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.ScrollChanged="ModelListBox_ScrollChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel  HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,5,0">
                                        <Border BorderThickness="2" BorderBrush="Black" Margin="5" DockPanel.Dock="Left">
                                            <Image Source="{Binding portrait_image_sq150}" MaxWidth="50" MaxHeight="50"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,0,5,5">
                                            <TextBlock Text="{Binding character_name}" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text="/" FontSize="13" Margin="5,0,5,0" Foreground="Gray"/>
                                            <TextBlock Text="{Binding name}" FontSize="13" Foreground="Gray" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,0" DockPanel.Dock="Right">
                                            <Image Source="{Binding user_icon_sq50}" Width="16" Height="16">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="8,8" RadiusX="16" RadiusY="16"/>
                                                </Image.Clip>
                                            </Image>
                                            <TextBlock Text="{Binding user_name}" FontSize="12" Foreground="Black" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding type_symbol}" FontSize="16" Foreground="{Binding type_brush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>
                <Grid>
                    <GroupBox Header="{DynamicResource VRoidHubWindow_ModelInfo}" FontSize="14" BorderThickness="0" BorderBrush="Transparent">
                        <Grid>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Right" Margin="0,-25,0,0">
                                <StackPanel.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.1"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </StackPanel.Background>
                                <Grid Height="25"/>
                                <Grid HorizontalAlignment="Right" VerticalAlignment="Stretch" Grid.Column="1" Margin="0,0,0.333,0" Visibility="{Binding licence_visibility}">
                                    <Grid.Resources>
                                        <Style TargetType="GroupBox">
                                            <Setter Property="MinWidth" Value="100"/>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="0">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_AllowedUser}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock FontSize="98" FontFamily="Meiryo UI" FontWeight="ExtraBold" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="?"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding characterization_allowed_user}" Value="author">
                                                                    <Setter Property="Text" Value="×"/>
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding characterization_allowed_user}" Value="everyone">
                                                                    <Setter Property="Text" Value="○"/>
                                                                    <Setter Property="Foreground" Value="Green"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,12" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="{DynamicResource Unknown}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding characterization_allowed_user}" Value="author">
                                                                    <Setter Property="Text" Value="{DynamicResource OnlyAuthor}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding characterization_allowed_user}" Value="everyone">
                                                                    <Setter Property="Text" Value="{DynamicResource AllowAll}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="1">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_ViolentExpression}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock FontSize="98" FontFamily="Meiryo UI" FontWeight="ExtraBold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="?"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding violent_expression}" Value="disallow">
                                                                    <Setter Property="Text" Value="×"/>
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding violent_expression}" Value="allow">
                                                                    <Setter Property="Text" Value="○"/>
                                                                    <Setter Property="Foreground" Value="Green"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,12" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="{DynamicResource Unknown}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding violent_expression}" Value="disallow">
                                                                    <Setter Property="Text" Value="{DynamicResource Disallow}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding violent_expression}" Value="allow">
                                                                    <Setter Property="Text" Value="{DynamicResource Allow}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="2">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_SexualExpression}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock FontSize="98" FontFamily="Meiryo UI" FontWeight="ExtraBold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="?"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding sexual_expression}" Value="disallow">
                                                                    <Setter Property="Text" Value="×"/>
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding sexual_expression}" Value="allow">
                                                                    <Setter Property="Text" Value="○"/>
                                                                    <Setter Property="Foreground" Value="Green"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,12" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="{DynamicResource Unknown}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding sexual_expression}" Value="disallow">
                                                                    <Setter Property="Text" Value="{DynamicResource Disallow}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding sexual_expression}" Value="allow">
                                                                    <Setter Property="Text" Value="{DynamicResource Allow}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="3">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_PersonalCommercialUse}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock FontSize="98" FontFamily="Meiryo UI" FontWeight="ExtraBold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="?"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding personal_commercial_use}" Value="disallow">
                                                                    <Setter Property="Text" Value="×"/>
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding personal_commercial_use}" Value="nonprofit">
                                                                    <Setter Property="Text" Value="△"/>
                                                                    <Setter Property="Foreground" Value="Orange"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding personal_commercial_use}" Value="profit">
                                                                    <Setter Property="Text" Value="○"/>
                                                                    <Setter Property="Foreground" Value="Green"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,12" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="{DynamicResource Unknown}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding personal_commercial_use}" Value="disallow">
                                                                    <Setter Property="Text" Value="{DynamicResource Disallow}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding personal_commercial_use}" Value="nonprofit">
                                                                    <Setter Property="Text" Value="{DynamicResource VRoidHubWindow_NonProfit}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding personal_commercial_use}" Value="profit">
                                                                    <Setter Property="Text" Value="{DynamicResource Allow}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="0">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_Modification}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock FontSize="98" FontFamily="Meiryo UI" FontWeight="ExtraBold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="?"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding modification}" Value="disallow">
                                                                    <Setter Property="Text" Value="×"/>
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding modification}" Value="allow">
                                                                    <Setter Property="Text" Value="○"/>
                                                                    <Setter Property="Foreground" Value="Green"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,12" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="{DynamicResource Unknown}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding modification}" Value="disallow">
                                                                    <Setter Property="Text" Value="{DynamicResource Disallow}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding modification}" Value="allow">
                                                                    <Setter Property="Text" Value="{DynamicResource Allow}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="1">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_Redistribution}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock FontSize="98" FontFamily="Meiryo UI" FontWeight="ExtraBold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="?"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding redistribution}" Value="disallow">
                                                                    <Setter Property="Text" Value="×"/>
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding redistribution}" Value="allow">
                                                                    <Setter Property="Text" Value="○"/>
                                                                    <Setter Property="Foreground" Value="Green"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,12" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="{DynamicResource Unknown}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding redistribution}" Value="disallow">
                                                                    <Setter Property="Text" Value="{DynamicResource Disallow}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding redistribution}" Value="allow">
                                                                    <Setter Property="Text" Value="{DynamicResource Allow}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="2">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_Credit}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock FontSize="98" FontFamily="Meiryo UI" FontWeight="ExtraBold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="?"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding credit}" Value="necessary">
                                                                    <Setter Property="Text" Value="！"/>
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding credit}" Value="unnecessary">
                                                                    <Setter Property="Text" Value="○"/>
                                                                    <Setter Property="Foreground" Value="Green"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,12" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="{DynamicResource Unknown}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding credit}" Value="necessary">
                                                                    <Setter Property="Text" Value="{DynamicResource VRoidHubWindow_Necessary}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding credit}" Value="unnecessary">
                                                                    <Setter Property="Text" Value="{DynamicResource VRoidHubWindow_Unnecessary}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="3">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_CorporateCommercialUse}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock FontSize="98" FontFamily="Meiryo UI" FontWeight="ExtraBold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="?"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding corporate_commercial_use}" Value="disallow">
                                                                    <Setter Property="Text" Value="×"/>
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding corporate_commercial_use}" Value="allow">
                                                                    <Setter Property="Text" Value="○"/>
                                                                    <Setter Property="Foreground" Value="Green"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,12" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="{DynamicResource Unknown}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding corporate_commercial_use}" Value="disallow">
                                                                    <Setter Property="Text" Value="{DynamicResource Disallow}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding corporate_commercial_use}" Value="allow">
                                                                    <Setter Property="Text" Value="{DynamicResource Allow}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </Grid>
                                <!-- VRM1.0モデルの利用条件(VRM0.xと同じ○×表示。項目は10種) -->
                                <Grid HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,0.333,0" Visibility="{Binding licence_vrm10_visibility}">
                                    <Grid.Resources>
                                        <local:Vrm10LicenseConverter x:Key="LicConv"/>
                                        <Style TargetType="GroupBox">
                                            <Setter Property="MinWidth" Value="100"/>
                                        </Style>
                                        <Style x:Key="Vrm10Symbol" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="72"/>
                                            <Setter Property="FontFamily" Value="Meiryo UI"/>
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                        <Style x:Key="Vrm10Label" TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,8"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_AllowedUser}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Vrm10Symbol}" Text="{Binding vrm10_avatar_user, Converter={StaticResource LicConv}, ConverterParameter=symbol}" Foreground="{Binding vrm10_avatar_user, Converter={StaticResource LicConv}, ConverterParameter=color}"/>
                                                <TextBlock Style="{StaticResource Vrm10Label}" Text="{Binding vrm10_avatar_user, Converter={StaticResource LicConv}, ConverterParameter=label}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_ViolentExpression}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Vrm10Symbol}" Text="{Binding vrm10_violence, Converter={StaticResource LicConv}, ConverterParameter=symbol}" Foreground="{Binding vrm10_violence, Converter={StaticResource LicConv}, ConverterParameter=color}"/>
                                                <TextBlock Style="{StaticResource Vrm10Label}" Text="{Binding vrm10_violence, Converter={StaticResource LicConv}, ConverterParameter=label}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_SexualExpression}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Vrm10Symbol}" Text="{Binding vrm10_sexuality, Converter={StaticResource LicConv}, ConverterParameter=symbol}" Foreground="{Binding vrm10_sexuality, Converter={StaticResource LicConv}, ConverterParameter=color}"/>
                                                <TextBlock Style="{StaticResource Vrm10Label}" Text="{Binding vrm10_sexuality, Converter={StaticResource LicConv}, ConverterParameter=label}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="3">
                                        <GroupBox Header="{DynamicResource VRoidHub_VRM10_PoliticalReligious}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Vrm10Symbol}" Text="{Binding vrm10_political_religious, Converter={StaticResource LicConv}, ConverterParameter=symbol}" Foreground="{Binding vrm10_political_religious, Converter={StaticResource LicConv}, ConverterParameter=color}"/>
                                                <TextBlock Style="{StaticResource Vrm10Label}" Text="{Binding vrm10_political_religious, Converter={StaticResource LicConv}, ConverterParameter=label}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <GroupBox Header="{DynamicResource VRoidHub_VRM10_AntisocialHate}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Vrm10Symbol}" Text="{Binding vrm10_antisocial_hate, Converter={StaticResource LicConv}, ConverterParameter=symbol}" Foreground="{Binding vrm10_antisocial_hate, Converter={StaticResource LicConv}, ConverterParameter=color}"/>
                                                <TextBlock Style="{StaticResource Vrm10Label}" Text="{Binding vrm10_antisocial_hate, Converter={StaticResource LicConv}, ConverterParameter=label}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_PersonalCommercialUse}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Vrm10Symbol}" Text="{Binding vrm10_personal_commercial, Converter={StaticResource LicConv}, ConverterParameter=symbol}" Foreground="{Binding vrm10_personal_commercial, Converter={StaticResource LicConv}, ConverterParameter=color}"/>
                                                <TextBlock Style="{StaticResource Vrm10Label}" Text="{Binding vrm10_personal_commercial, Converter={StaticResource LicConv}, ConverterParameter=label}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_CorporateCommercialUse}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Vrm10Symbol}" Text="{Binding vrm10_corporate_commercial, Converter={StaticResource LicConv}, ConverterParameter=symbol}" Foreground="{Binding vrm10_corporate_commercial, Converter={StaticResource LicConv}, ConverterParameter=color}"/>
                                                <TextBlock Style="{StaticResource Vrm10Label}" Text="{Binding vrm10_corporate_commercial, Converter={StaticResource LicConv}, ConverterParameter=label}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_Modification}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Vrm10Symbol}" Text="{Binding vrm10_modification, Converter={StaticResource LicConv}, ConverterParameter=symbol}" Foreground="{Binding vrm10_modification, Converter={StaticResource LicConv}, ConverterParameter=color}"/>
                                                <TextBlock Style="{StaticResource Vrm10Label}" Text="{Binding vrm10_modification, Converter={StaticResource LicConv}, ConverterParameter=label}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="3">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_Redistribution}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Vrm10Symbol}" Text="{Binding vrm10_redistribution, Converter={StaticResource LicConv}, ConverterParameter=symbol}" Foreground="{Binding vrm10_redistribution, Converter={StaticResource LicConv}, ConverterParameter=color}"/>
                                                <TextBlock Style="{StaticResource Vrm10Label}" Text="{Binding vrm10_redistribution, Converter={StaticResource LicConv}, ConverterParameter=label}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="4">
                                        <GroupBox Header="{DynamicResource VRoidHubWindow_Credit}" Margin="3" BorderBrush="DarkGray" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Vrm10Symbol}" Text="{Binding vrm10_credit, Converter={StaticResource LicConv}, ConverterParameter=symbol}" Foreground="{Binding vrm10_credit, Converter={StaticResource LicConv}, ConverterParameter=color}"/>
                                                <TextBlock Style="{StaticResource Vrm10Label}" Text="{Binding vrm10_credit, Converter={StaticResource LicConv}, ConverterParameter=label}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="5" FontSize="16" Foreground="Red" FontWeight="Bold" Visibility="{Binding licence_visibility}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value=""/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding credit}" Value="necessary">
                                                    <Setter Property="Text" Value="{DynamicResource VRoidHubWindow_CreditCautionDescription1}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="5,0,5,5" FontSize="16" Foreground="Red" FontWeight="Bold" Visibility="{Binding licence_visibility}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value=""/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding credit}" Value="necessary">
                                                    <Setter Property="Text" Value="{DynamicResource VRoidHubWindow_CreditCautionDescription2}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <DockPanel VerticalAlignment="Bottom">

                                <DockPanel  HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Border BorderThickness="3" BorderBrush="Black" Margin="10" DockPanel.Dock="Left">
                                        <Image Source="{Binding portrait_image_sq150}" Width="100" Height="100"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,0,10,10">
                                        <TextBlock Text="{Binding character_name}" FontSize="26" FontWeight="Bold"/>
                                        <TextBlock Text="/" FontSize="26" Margin="10,0,10,0" Foreground="Gray"/>
                                        <TextBlock Text="{Binding name}" FontSize="26" Foreground="Gray" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,0" DockPanel.Dock="Right">
                                        <Image Source="{Binding user_icon_sq50}" Width="30" Height="30">
                                            <Image.Clip>
                                                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/>
                                            </Image.Clip>
                                        </Image>
                                        <TextBlock Text="{Binding user_name}" FontSize="18" Foreground="Black" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding type_symbol}" FontSize="32" Foreground="{Binding type_brush}"/>
                                </DockPanel>
                            </DockPanel>

                            <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Content="{DynamicResource VRoidHubWindow_OpenOnVRoidHub}" Tag="{Binding vroid_hub_url}" Padding="20,10,20,10" Margin="20,20,20,0" Name="VRoidHubUrlButton" Click="VRoidHubUrlButton_Click"/>
                                <Button Content="{DynamicResource VRoidHubWindow_LoadModel}" Padding="20,10,20,10" Margin="20,10,20,20" Name="LoadModelButton" Click="LoadModelButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </DockPanel>
        </Grid>
        <Grid Name="ProgressGrid" Background="White" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
                <TextBlock Text="{DynamicResource VRoidHubWindow_Loading}" HorizontalAlignment="Center" Margin="20" FontSize="20"/>
                <ProgressBar IsIndeterminate="True" Name="LoadProgressBar" Minimum="0.0" Maximum="1.0" Value="0.0" VerticalAlignment="Center" Height="30" HorizontalAlignment="Center" Width="300"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
