<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.1" />
    </startup>
    <runtime>
        <!--
          ダウンロードしたZIPをエクスプローラーで展開すると、中のDLLにゾーン識別子
          (Zone.Identifier)が付く。これが付いたDLLは既定では Assembly.LoadFrom が
          「操作はサポートされません(0x80131515)」で失敗し、ControlPanel/Plugins/ の
          プラグインが1つも読み込めなくなる。ネットワークドライブに置いた場合も同じ。
          RemoveZoneID.bat を実行してもらわなくても動くようにする。
        -->
        <loadFromRemoteSources enabled="true"/>
    </runtime>
</configuration>