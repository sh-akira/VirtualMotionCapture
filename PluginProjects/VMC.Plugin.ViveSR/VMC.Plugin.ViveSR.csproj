<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PluginKind>Unity</PluginKind>
    <PluginFolderName>ViveSR</PluginFolderName>
    <ProjectGuid>{B1C0F1E1-0002-4A00-9000-000000000002}</ProjectGuid>
    <RootNamespace>VMC.Plugin.Vive</RootNamespace>
    <AssemblyName>VMC.Plugin.ViveSR</AssemblyName>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <ItemGroup>
    <Compile Include="..\Shared\ViveSRPipeCommands.cs">
      <Link>Shared\ViveSRPipeCommands.cs</Link>
    </Compile>
    <Compile Include="ViveProEyePlugin.cs" />
    <Compile Include="ViveFacialTrackerPlugin.cs" />
    <!-- VIVE SRanipal SDK のソース(再配布不可のためリポジトリには含めない) -->
    <Compile Include="$(ExternalSdkRoot)ViveSR\Scripts\**\*.cs">
      <Link>ViveSRSDK\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <NativePluginFile Include="$(ExternalSdkRoot)ViveSR\Plugins\*.dll" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
