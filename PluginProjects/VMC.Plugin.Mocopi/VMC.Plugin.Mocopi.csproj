<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- PluginKind / PluginFolderName は Directory.Build.props の条件で使うので、
       Microsoft.Common.props(=Directory.Build.props を取り込む)より前に書く -->
  <PropertyGroup>
    <PluginKind>Unity</PluginKind>
    <PluginFolderName>mocopi</PluginFolderName>
    <ProjectGuid>{B1C0F1E1-0001-4A00-9000-000000000001}</ProjectGuid>
    <RootNamespace>VMC.Plugin.Mocopi</RootNamespace>
    <AssemblyName>VMC.Plugin.Mocopi</AssemblyName>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <ItemGroup>
    <Compile Include="..\Shared\MocopiPipeCommands.cs">
      <Link>Shared\MocopiPipeCommands.cs</Link>
    </Compile>
    <Compile Include="MocopiPlugin.cs" />
    <!-- mocopi Receiver Plugin for Unity のソース
         (SDK\README.md 参照。再配布不可のためリポジトリには含めない) -->
    <Compile Include="SDK\MocopiReceiver\Runtime\**\*.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
