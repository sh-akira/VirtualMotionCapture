<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="Tobii_Title">Tobii Eye Tracker 4C</system:String>
    <system:String x:Key="Tobii_UseTobiiCheckBox">使用する</system:String>
    <system:String x:Key="Tobii_CalibrationDescription">Tobii正面の頭の位置を取得するためモデルのキャリブレーション完了後にTobiiの前に移動してモニターの中心を見ながらキャリブレーションボタンを押してください</system:String>
    <system:String x:Key="Tobii_EyeOffset">目の位置オフセット(0.01=1cm)</system:String>
    <system:String x:Key="Tobii_Close">閉じる</system:String>
    <system:String x:Key="Tobii_EyeScale">目の移動範囲(マイナスで反転します)</system:String>
    <system:String x:Key="Tobii_Calibration">キャリブレーション</system:String>
    <system:String x:Key="Tobii_Vertical">上下方向</system:String>
    <system:String x:Key="Tobii_Horizontal">左右方向</system:String>

</ResourceDictionary>
