<Project>
  <!--
    公式プラグインの共通設定。

    プラグインは本体とは別にビルドして Plugins/ へ配布する。
    Unity側プラグインは Unity が生成したアセンブリ(Library/ScriptAssemblies)と
    再配布不可のSDK(ExternalSDK/)を参照するため、
    「一度Unityでプロジェクトを開いてから」でないとビルドできない。
  -->
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\</RepositoryRoot>
    <UnityScriptAssemblies>$(RepositoryRoot)Library\ScriptAssemblies\</UnityScriptAssemblies>
    <UnityManagedRoot>$(RepositoryRoot)UnityBuild\VirtualMotionCapture_Data\Managed\</UnityManagedRoot>
    <!-- Unityのインストール先が違う場合は、環境変数か /p:UnityEditorRoot=... で上書きする -->
    <UnityEditorRoot Condition=" '$(UnityEditorRoot)' == '' ">C:\Program Files\Unity\Hub\Editor\2022.3.76f1\Editor\Data\</UnityEditorRoot>

    <!-- 配布先。Unity側は Plugins/、コントロールパネル側は ControlPanel/Plugins/ -->
    <PluginOutputRoot>$(RepositoryRoot)UnityBuild\Plugins\</PluginOutputRoot>
    <ControlPanelPluginOutputRoot>$(RepositoryRoot)BuildRootFiles\ControlPanel\Plugins\</ControlPanelPluginOutputRoot>

    <!--
      エディタ実行用のコピー先。
      Unityエディタでは Application.dataPath + "/../Plugins/" がリポジトリ直下を指すため、
      ここへ置いておくと再生ボタンだけでプラグインを読み込める。
    -->
    <EditorPluginOutputRoot>$(RepositoryRoot)Plugins\</EditorPluginOutputRoot>

    <!--
      同じくコントロールパネル側のコピー先。
      exe は bin\<構成>\ControlPanel\ に出て、その直下の Plugins\ が実行時の探索先になる。
      コントロールパネルは BETA/FANBOX/FREE でビルドするため、その3構成すべてへ入れる。
      (本体をビルドすると BuildRootFiles からの xcopy でも入るが、
       プラグインだけビルドした時に反映されないためここでも直接入れる)
    -->
    <ControlPanelBinRoot>$(RepositoryRoot)ControlWindowWPF\ControlWindowWPF\bin\</ControlPanelBinRoot>
    <ControlPanelEditorConfigurations>BETA;FANBOX;FREE</ControlPanelEditorConfigurations>

    <!-- 参照するDLL。共有DLLはUnity側にコピー済みのものを使う -->
    <UnityMemoryMappedFileDll>$(RepositoryRoot)Assets\ExternalPlugins\UnityMemoryMappedFile\UnityMemoryMappedFile.dll</UnityMemoryMappedFileDll>
    <ControlPanelPluginApiDll>$(RepositoryRoot)ControlWindowWPF\VMC.ControlPanel.PluginAPI\bin\Debug\VMC.ControlPanel.PluginAPI.dll</ControlPanelPluginApiDll>
  </PropertyGroup>

  <!--
    プラグイン共通の設定。PluginKind と PluginFolderName を各プロジェクトで指定すれば、
    参照・出力先・コピー処理は Directory.Build.targets が面倒を見る。
  -->
  <PropertyGroup Condition=" '$(PluginKind)' == 'Unity' ">
    <OutputPath>$(PluginOutputRoot)$(PluginFolderName)\</OutputPath>
    <TargetFrameworkVersion>v4.7.1</TargetFrameworkVersion>
    <OutputType>Library</OutputType>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;UNITY_STANDALONE;UNITY_STANDALONE_WIN;UNITY_64</DefineConstants>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- 参照先は本体に入っているので配布物には含めない -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(PluginKind)' == 'ControlPanel' ">
    <OutputPath>$(ControlPanelPluginOutputRoot)$(PluginFolderName)\</OutputPath>
    <TargetFrameworkVersion>v4.7.1</TargetFrameworkVersion>
    <OutputType>Library</OutputType>
    <ProjectTypeGuids>{60dc8134-eba5-43b8-bcc9-bb4bc16c2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(PluginKind)' != '' ">
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
</Project>
